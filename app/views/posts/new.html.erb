<div>
  <h1 class="font-bold text-4xl">Make your post here!</h1>
  
  <%# this is our new post form %>
  <%# post_path is == to /posts %>
  <%= form_with model: @post do |form| %>
    <% if @post.errors.any? %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold">Oops!</strong>
        <span class="block sm:inline"><%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:</span>
        <ul class="list-disc pl-5">
          <% @post.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div>
      <%= form.label :title %><br>
      <%= form.text_field :title, class: "border border-gray-300 rounded py-2 px-4" %>
    </div>

    <div>
      <%= form.label :body %><br>
      <%= form.text_area :body, class: "border border-gray-300 rounded py-2 px-4" %>
    </div>

    <div>
      <%= form.submit "Create Post", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded"  %>
    </div>
  <% end %>
</div>
